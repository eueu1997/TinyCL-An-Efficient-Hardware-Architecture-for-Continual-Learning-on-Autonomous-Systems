module tb_dadda_top;
    // Define parameters
    parameter int NBitIn = 16;
    parameter int NBitOut = 20;
    parameter int NOps = 9;
    
    // Define time units and precision
    `timescale 1ns/1ps
    
    // Instantiate the dadda_top module
    dadda_top#(
        .NBitIn(NBitIn),
        .NBitOut(NBitOut),
        .NOps(NOps)
    ) u_dadda_top (
        .DataIn(DataIn),
        .DataOut(DataOut)
    );
    
    // Define signals
    logic [1:NOps][NBitIn:1] DataIn;
    logic [NBitOut:1] DataOut;
    
    // Initialize variables
    initial begin
        // Generate random inputs
        foreach(DataIn[i]) begin
            foreach(DataIn[i][j]) begin
                DataIn[i][j] = $urandom_range(0, (1<<NBitIn)-1);
            end
        end
        
        // Apply inputs
        #1;
        
        // Monitor outputs
        $display("Input Data:");
        foreach(DataIn[i]) begin
            $display("%0d:", i);
            foreach(DataIn[i][j]) begin
                $display("  %0d: %0d", j, DataIn[i][j]);
            end
        end
        
        #1;
        
        $display("Output Data:");
        foreach(DataOut[i]) begin
            $display("  %0d: %0d", i, DataOut[i]);
        end
        
        // Add your verification code here
        
       
    end
endmodule
